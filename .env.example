# Copy this file to .env.local. Every value is optional: the app starts without any of
# them, and stores its database and uploaded files in the .data folder.

# The public address of this app. Used in invitation and password reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the database and uploaded files are kept. Defaults to .data/database and .data/files.
# DATABASE_DIR=.data/database
# FILE_STORAGE_DIR=.data/files

# Push notifications. Generate keys with: npx web-push generate-vapid-keys
# Leave empty to turn push off. In-app notifications still work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-company.com

# Key that attendance systems such as Pagerbook send in the x-integration-key header to
# /api/integrations/attendance. Leave empty to turn the import API off.
ATTENDANCE_IMPORT_SECRET=

# Only for running a production build over plain http on a network address other
# than localhost. Sign-in cookies are otherwise marked secure in production.
# ALLOW_INSECURE_COOKIES=1

# Google sign-in through Firebase. From Firebase: Project settings > General > Your apps
# > SDK setup and configuration. These are public by design. Leave any empty to hide
# the Google button; email and password sign-in always works. See docs/SetupGuide.md.
# AUTH_DOMAIN: <project>.firebaseapp.com on your computer; on the live site, the site's
# own address (crm.bmumarketing.in), so Google sign-in works in the Android app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase, for the live site on Vercel. See docs/SetupGuide.md, "Going live".
# On this computer these are only used by npm run db:supabase: the app itself keeps
# using the database in .data unless DATABASE_PROVIDER=supabase is set, which belongs
# in Vercel's settings, not here.
# DATABASE_PROVIDER=supabase
# SUPABASE_DB_POOLER_URL=postgresql://postgres.<project>:<password>@aws-...pooler.supabase.com:6543/postgres
# SUPABASE_DB_SESSION_URL=postgresql://postgres.<project>:<password>@aws-...pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# Only with Supabase, which sends push requests over the web to this address.
# Push delivery otherwise runs inside the app and needs neither of these.
# NOTIFICATION_DISPATCH_URL=https://your-site.example/api/notifications/dispatch
# NOTIFICATION_DISPATCH_SECRET=

# Encrypts Aadhaar and bank account numbers. 32 random bytes in base64; make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a safe copy and never change it once numbers are saved. Use a different value on Vercel.
# FIELD_ENCRYPTION_KEY=

# The Android app (built with PWABuilder) opens the site full-screen only when these match
# the app. Both come from PWABuilder's download (assetlinks.json); neither is secret.
# Set them on Vercel. Several fingerprints can be separated by commas.
# ANDROID_APP_PACKAGE=in.bmumarketing.crm.twa
# ANDROID_APP_SHA256=AB:CD:...
